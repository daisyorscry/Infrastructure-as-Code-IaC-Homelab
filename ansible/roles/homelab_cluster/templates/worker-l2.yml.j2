{% for worker in cluster_worker_targets %}
---
{% if cluster_stack == 'cilium' %}
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: {{ cluster_name }}-{{ worker }}
spec:
  loadBalancerIPs: true
  nodeSelector:
    matchLabels:
      kubernetes.io/hostname: {{ worker | to_json }}
  interfaces:
{% for interface in hostvars[worker].node_l2_interfaces %}
    - {{ ('^' ~ (interface | regex_escape) ~ '$') | to_json }}
{% endfor %}
{% else %}
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ cluster_name }}-{{ worker }}
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ cluster_name }}-lan
  nodeSelectors:
    - matchLabels:
        kubernetes.io/hostname: {{ worker | to_json }}
  interfaces:
{% for interface in hostvars[worker].node_l2_interfaces %}
    - {{ interface | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
