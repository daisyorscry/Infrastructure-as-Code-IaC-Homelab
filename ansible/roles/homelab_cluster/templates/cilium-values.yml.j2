kubeProxyReplacement: true
k8sServiceHost: {{ cluster_api_ip | to_json }}
k8sServicePort: 6443
cni:
  install: true
  exclusive: true
ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
      - {{ pod_cidr | to_json }}
    clusterPoolIPv4MaskSize: 24
routingMode: tunnel
tunnelProtocol: vxlan
l7Proxy: true
envoy:
  enabled: true
gatewayAPI:
  enabled: true
  externalTrafficPolicy: Cluster
l2announcements:
  enabled: true
k8sClientRateLimit:
  qps: 30
  burst: 60
operator:
  replicas: 2
