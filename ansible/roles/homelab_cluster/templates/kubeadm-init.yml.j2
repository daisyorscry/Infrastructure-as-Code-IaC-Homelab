apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ cluster_api_ip | to_json }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ cluster_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ cluster_api_ip | to_json }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name | to_json }}
kubernetesVersion: {{ ('v' ~ kubernetes_version) | to_json }}
controlPlaneEndpoint: {{ (cluster_api_ip ~ ':6443') | to_json }}
networking:
  podSubnet: {{ pod_cidr | to_json }}
  serviceSubnet: {{ service_cidr | to_json }}
apiServer:
  certSANs:
    - {{ cluster_api_ip | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
{% if cluster_stack == 'istio' %}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: iptables
{% endif %}
